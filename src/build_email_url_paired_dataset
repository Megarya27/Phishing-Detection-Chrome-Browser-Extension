#This script builds a dataset of (email text, URL) pairs, where the email text is 
# the cleaned subject and body of an email, and the URL is a link extracted from 
# that email. Each pair is labeled with the original label of the email.
# The script also computes structural features for each URL using the 
# feature_extraction module.

#uses the email text dataset used to train the DistilBERT model, and 
# excludes any email text that was used for training DistilBERT. 
# This ensures that the hybrid model is evaluated on unseen data.

#limitation: the 10 destination-DOM features (Favicon, Request_URL, URL_of_Anchor,
# Links_in_tags, SFH, Submitting_to_email, on_mouseover, RightClick,
#popUpWidnow, Iframe) that require rendering the page a link points to are  
# not included here because they require a headless browser and are too slow to compute in real-time for every URL.
# These are set to default values 

import csv
import os
import re
import socket
import sys
import time
from collections import defaultdict
from pathlib import Path
from urllib.parse import urlparse

from global_config import ROOT

sys.path.insert(0, str(ROOT / "server"))
from feature_extraction import complete_feature_vector, STRUCTURAL_FEATURES  

from data_text import load_raw_corpora, clean_email_text, build_text_dataset  

OUT_DIR = ROOT / "prepared_datasets" / "paired_hybrid"
OUT_DIR.mkdir(parents=True, exist_ok=True)
OUT_PATH = OUT_DIR / "paired_hybrid_email_urls.csv"
SESSION_PATH = OUT_DIR / "email_url_session_in_progress.csv"

#used to extract URLs from email text. Matches http:// or https:// 
#followed by any non-whitespace characters
URL_RE = re.compile(r"https?://[^\s\"'<>\)\]]+")
#sentence punctuation at the end of a URL is often not part of the URL, so it is stripped it off.
TRAILING_PUNCT_RE = re.compile(r"[.,;:!?'\"]+$")
# 2 different kinds of junk, for example tracking pixels, unsubscribe links, and other non-content URLs 
# that are not useful for phishing detection.
JUNK_URL_SUBSTRINGS = (
    "unsubscribe", "click.", "track.", "beacon.", "pixel.", ".gif", ".jpg",
    ".png", ".css", ".js", "mailto:",
)
# caps the maximum number of URLs to include from a single domain. 
# This is to avoid overrepresenting any single domain in the dataset.
MAX_URLS_PER_DOMAIN = 3 
CSV_FIELDNAMES = STRUCTURAL_FEATURES + ["url", "text", "label", "status"]

socket.setdefaulttimeout(6.0) #ensures that DNS lookups and HTTP requests do not hang indefinitely.

DELAY_BETWEEN_LOOKUPS_SECONDS = 0.5  #rate limit to avoid overwhelming servers and to reduce the chance of being blocked.

#cleans a URL by removing trailing punctuation and filtering out junk URLs.
def clean_url(url: str) -> str | None:
    url = TRAILING_PUNCT_RE.sub("", url)
    lowered = url.lower()
    if any(junk in lowered for junk in JUNK_URL_SUBSTRINGS):
        return None
    try:
        parsed = urlparse(url)
        if not parsed.netloc:
            return None
    except ValueError:
        return None
    return url

#returns the registrable domain of a URL, which is the domain that 
# can be registered with a domain registrar.
#this is used to count how many URLs from the same domain have 
#been included in the dataset.
def registrable_domain(url: str) -> str:
    host = urlparse(url).hostname or ""
    parts = host.split(".")
    return ".".join(parts[-2:]) if len(parts) >= 2 else host

#this ensures that if script crashes, it can be resumed without losing progress
class IncrementalCsvWriter:
    def __init__(self, path: Path, fieldnames: list[str]):
        self.path = path
        is_new = not path.exists() #check if file already exists to determine if header needs to be written
        #append mode is used to avoid overwriting existing data, and newline="" is used to prevent extra blank lines on Windows.
        self._file = open(path, "a", newline="", encoding="utf-8")
        self._writer = csv.DictWriter(self._file, fieldnames=fieldnames, restval="")
        if is_new:
            self._writer.writeheader()
            self._file.flush()
            os.fsync(self._file.fileno())

    def write(self, row: dict):
        self._writer.writerow(row)
        self._file.flush() #flushes the file buffer to ensure that data is 
                            #written to disk immediately, which is important for incremental writing in case of crashes.
        os.fsync(self._file.fileno()) #commits the file to disk

    def close(self):
        self._file.close()

#set of email texts that were used to train DistilBERT, 
#so that they can be excluded from the hybrid dataset.
def _distilbert_train_texts():
    splits = build_text_dataset()
    return set(splits["train"]["text"])

#collects (email text, URL) pairs from the raw email dataset, 
# cleans them, and filters out junk URLs and duplicates.
def collect_email_url_pairs():
    df = load_raw_corpora()
    excluded_texts = _distilbert_train_texts()
    per_domain_count = defaultdict(int)
    seen_urls = set()
    pairs = []
    per_source_counts = defaultdict(int)
    n_excluded_as_dbert_train = 0

 #itertuples used instead of iterrows as it is faster and more memory efficient.
    for row in df.itertuples(index=False):
        raw_urls = URL_RE.findall(str(row.body))
        #1 URL per email is enough for the hybrid model, 
        #so the first one that is not junk and not a duplicate is picked.
        chosen_url = None
        for raw_url in raw_urls:
            url = clean_url(raw_url)
            if url is None or url in seen_urls:
                continue
            domain = registrable_domain(url)
            if per_domain_count[domain] >= MAX_URLS_PER_DOMAIN:
                continue
            chosen_url = url # a valid URL that is not junk, not a duplicate, and not over the domain limit
            break
        if chosen_url is None:
            continue
        # the email text is cleaned and filtered to exclude any that were used to train DistilBERT.
        text = clean_email_text(row.subject, row.body)
        if len(text) <= 20:
            continue  
        if text in excluded_texts:
            n_excluded_as_dbert_train += 1
            continue
        # the chosen URL is added to the seen set, the domain count is incremented 
        # and the (URL, label, text) tuple is added to the pairs list.
        seen_urls.add(chosen_url)
        per_domain_count[registrable_domain(chosen_url)] += 1
        pairs.append((chosen_url, int(row.label), text))
        per_source_counts[row.source] += 1

    print(f"Found {len(pairs)} usable (url, label, text) pairs across "
          f"{len(set(registrable_domain(u) for u, _, _ in pairs))} distinct domains "
          f"({n_excluded_as_dbert_train} candidates skipped because DistilBERT was "
          f"trained on that exact email text).")
    for source, count in per_source_counts.items():
        print(f"  {source}: {count}")
    return pairs

def build_row(url: str, label: int, text: str) -> dict:
    #10 dom features that require rendering the page are not included here
    #so they are set to default values.
    try:
        vector = complete_feature_vector(url, {})
        row = {name: value for name, value in zip(STRUCTURAL_FEATURES, vector)}
        row.update({"url": url, "text": text, "label": label, "status": "ok"})
        return row
    #one bad URL should not stop entire dataset building process, 
    #so exceptions are caught and logged in status field.
    except Exception as exc:  
        return {"url": url, "text": text, "label": label, "status": f"error: {exc}"}


def main():
    if SESSION_PATH.exists():
        print(f"Found a leftover session file from a previous interrupted run at "
              f"{SESSION_PATH} -- merging it into {OUT_PATH} before starting.")
        _merge_into(SESSION_PATH, OUT_PATH)
        SESSION_PATH.unlink()

    pairs = collect_email_url_pairs()
    already_done = set()
    #resumes from where it left off if the output file already exists 
    #by filtering out URLs that have already been processed.
    if OUT_PATH.exists():
        import pandas as pd
        already_done = set(pd.read_csv(OUT_PATH)["url"])
        pairs = [(u, l, t) for u, l, t in pairs if u not in already_done]
        print(f"{len(already_done)} URLs already processed in {OUT_PATH} -- "
              f"{len(pairs)} remaining.")

    writer = IncrementalCsvWriter(SESSION_PATH, CSV_FIELDNAMES)
    try:
        for i, (url, label, text) in enumerate(pairs, 1):
            row = build_row(url, label, text)
            writer.write(row)
            print(f"[{i}/{len(pairs)}] label={label} status={row.get('status')} url={url}")
            time.sleep(DELAY_BETWEEN_LOOKUPS_SECONDS) #rate limit to avoid overwhelming servers and to reduce the chance of being blocked.
    finally:
        writer.close()

    _merge_into(SESSION_PATH, OUT_PATH)
    SESSION_PATH.unlink()


def _merge_into(session_path: Path, out_path: Path):
    import pandas as pd
    df = pd.read_csv(session_path)
    if out_path.exists():
        existing = pd.read_csv(out_path)
        before = len(existing)
        #keep="last" ensures that if the same URL appears in both the existing and new data, the new data will overwrite the old data.
        df = (pd.concat([existing, df], ignore_index=True).drop_duplicates(subset="url", keep="last")) 
        print(f"Merged with {before} existing rows at {out_path} -> {len(df)} total after dedup.")

    df.to_csv(out_path, index=False)
    n_ok = (df["status"] == "ok").sum()
    print(f"\nWrote {len(df)} rows to {out_path}")
    print(f"Successful feature extractions: {n_ok}/{len(df)} ({n_ok / len(df):.1%})")


if __name__ == "__main__":
    main()
